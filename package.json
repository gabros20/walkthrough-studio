{
  "name": "walkthrough-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Agent-driven toolkit for app walkthrough films: studio instance, recorder, HyperFrames film, sound, voiceover, delivery.",
  "license": "MIT",
  "repository": "https://github.com/gabros20/walkthrough-studio",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "walkthrough": "bin/walkthrough.mjs"
  },
  "scripts": {
    "cli": "node bin/walkthrough.mjs",
    "setup": "npm --prefix recorder install && cd recorder && npx playwright-core install chromium",
    "capture-test": "node recorder/capture-test.mjs new 2 idle 30",
    "take": "node recorder/takes/run.mjs",
    "film:dry": "cd film && node build.mjs --dry",
    "film:build": "cd film && node build.mjs",
    "film:check": "cd film && npx --yes hyperframes@0.9.16 check",
    "sound": "node sound/build-sound.mjs",
    "package:verify": "python3 -I delivery/verify.py",
    "validate": "claude plugin validate .",
    "check": "node scripts/check.mjs",
    "check:site": "cd site && npm ci && npm run build",
    "lint:skills": "node scripts/lint-skills.mjs",
    "version:set": "node scripts/version.mjs",
    "test": "node test/run.mjs",
    "test:update": "node test/run.mjs --update",
    "test:render": "node test/run.mjs --render"
  }
}
