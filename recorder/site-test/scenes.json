        {
          "mark": {
            "role": "list",
            "name": "Results"
          },
          "label": "results list"
        },
        {
          "click": {
            "text": "Result 6:"
          },
          "label": "result 6"
        },
        {
          "mark": {
            "text": "Result 6:"
          },
          "label": "result 6 card"
        },
        {
          "park": true,
          "label": "result 6 park"
        },
        {
          "scroll": {
            "dy": -600
          },
          "label": "back to top"
        },
        {
          "click": {
            "text": "Result 8:"
          },
          "label": "result 8"
        },
        {
          "hold": 0.8
