{
  "scenes": [
    {
      "name": "take-1-search",
      "start": "/site.html",
      "steps": [
        {
          "hold": 0.6
        },
        {
          "mark": {
            "role": "heading",
            "name": "Find a bike for this spring"
          },
          "label": "headline"
        },
        {
          "type": "ridgeline",
          "into": {
            "placeholder": "Search bikes"
          },
          "label": "query"
        },
        {
          "click": {
            "role": "button",
            "name": "Search"
          },
          "label": "search"
        },
        {
          "wait": {
            "quiet": {
              "ms": 600,
              "timeout": 15000
            }
          },
          "label": "results"
        },
        {
          "mark": {
            "role": "list",
            "name": "Results"
          },
          "label": "results list"
        },
        {
          "click": {
            "text": "Result 6:"
          },
          "label": "result 6"
        },
        {
          "mark": {
            "text": "Result 6:"
          },
          "label": "result 6 card"
        },
        {
          "park": true,
          "label": "result 6 park"
        },
        {
          "scroll": {
            "dy": -600
          },
          "label": "back to top"
        },
        {
          "click": {
            "text": "Result 8:"
          },
          "label": "result 8"
        },
        {
          "hold": 0.8
        }
      ]
    },
    {
      "name": "take-2-ride",
      "start": "/site.html",
      "steps": [
        {
          "hold": 0.6
        },
        {
          "mark": {
            "role": "heading",
            "name": "Find a bike for this spring"
          },
          "label": "headline"
        },
        {
          "click": {
            "role": "link",
            "name": "Size guide (CSV)"
          },
          "label": "size guide"
        },
        {
          "hold": 0.8
        },
        {
          "click": {
            "role": "button",
            "name": "Book a test ride"
          },
          "label": "book"
        },
        {
          "wait": {
            "visible": "#booking:not(:empty)"
          },
          "label": "booked"
        },
        {
          "mark": {
            "selector": "#booking"
          },
          "label": "booking note"
        },
        {
          "hold": 0.8
        },
        {
          "click": {
            "role": "link",
            "name": "Spec sheet"
          },
          "label": "spec sheet"
        },
        {
          "wait": {
            "quiet": {
              "ms": 800,
              "timeout": 10000
            }
          },
          "label": "after spec sheet"
        },
        {
          "mark": "h1",
          "label": "page headline"
        },
        {
          "hold": 1.0
        }
      ]
    }
  ]
}
